{
  "name": "canada-pay-calculator-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && python ../Scripts/export_web_tax_data.py --check",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "vite build && node scripts/finalize-pwa.mjs",
    "preview": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "tax:sync": "python ../Scripts/export_web_tax_data.py"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
